{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Space Risk Radar metric snapshot",
  "type": "object",
  "required": ["dataset_id", "retrieved_at", "source", "metrics", "methodology"],
  "properties": {
    "dataset_id": {"type": "string"},
    "retrieved_at": {"type": "string", "format": "date"},
    "source": {"type": "object", "required": ["name", "url", "portal_last_update"]},
    "metrics": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "label", "value", "unit", "classification", "reference_date", "source_url", "verification_status"],
        "properties": {
          "id": {"type": "string"},
          "label": {"type": "string"},
          "value": {"type": "number"},
          "unit": {"type": "string"},
          "classification": {"enum": ["OBSERVED / CATALOGUED", "MODELLED", "DERIVED", "REPORTED"]},
          "reference_date": {"type": "string"},
          "source_url": {"type": "string", "format": "uri"},
          "uncertainty_note": {"type": "string"}
        },
        "additionalProperties": true
      }
    },
    "methodology": {
      "type": "object",
      "required": ["no_interpolation", "separate_catalogued_and_modelled", "preserve_source_discrepancies"],
      "properties": {
        "no_interpolation": {"const": true},
        "separate_catalogued_and_modelled": {"const": true},
        "preserve_source_discrepancies": {"const": true}
      }
    }
  },
  "additionalProperties": true
}
